{
  "manifest_version": 3,
  "name": "TRACE ERP — CS Quick Tagging Assistant",
  "version": "1.0.0",
  "description": "Instant 1-Click Shopify Order Tagging Bar integrated with TRACE ERP.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://admin.shopify.com/*",
    "https://*.myshopify.com/*",
    "https://trace-erp-production.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/store/*/orders/*",
        "https://admin.shopify.com/owner/*/orders/*",
        "https://*.myshopify.com/admin/orders/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
